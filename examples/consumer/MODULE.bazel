module(name = "rules_gradle_offline_maven_consumer")

bazel_dep(name = "curlewlabs_rules_gradle_offline_maven", version = "0.1.0")
bazel_dep(name = "rules_python", version = "2.4.6")

gradle_maven = use_extension("@curlewlabs_rules_gradle_offline_maven//maven:extensions.bzl", "gradle_maven")
gradle_maven.lock(
    name = "consumer_maven",
    lock = "//:gradle/verification-metadata.xml",
    repositories = ["https://repo.maven.apache.org/maven2"],
)
use_repo(gradle_maven, "consumer_maven")

# This checkout's module. tools/check_consumer.py points the same consumer at a
# prepared release archive instead, with --override_module.
local_path_override(
    module_name = "curlewlabs_rules_gradle_offline_maven",
    path = "../..",
)
